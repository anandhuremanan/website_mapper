# Website Mapper server configuration. All values are optional; defaults shown.
# The server reads the process environment (it does not load this file itself):
#   set -a; source .env; set +a; go run ./cmd/server

SERVER_PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

# Crawler identity. BOT_INFO_URL is the public page describing the crawler
# (the client's /bot page) and is included in the default User-Agent:
#   WebsiteMapperBot/0.1 (+<BOT_INFO_URL>)
# Set both before scanning real sites. BOT_CONTACT is an email or URL shown
# on the /bot page so site owners can reach the operator.
BOT_INFO_URL=http://localhost:3000/bot
BOT_CONTACT=
# Overrides the full User-Agent. Its product token (text before the first
# "/") is what robots.txt User-agent lines are matched against.
# SCAN_USER_AGENT=WebsiteMapperBot/0.1 (+https://your-domain.example/bot)

# Apply each host's robots.txt while crawling. If robots.txt cannot be
# fetched, crawling continues normally.
SCAN_RESPECT_ROBOTS=true

# Per-scan request limits across all hosts: total outbound requests and
# overall request rate. SCAN_REQUESTS_PER_SECOND below limits each host.
SCAN_MAX_REQUESTS=3000
SCAN_MAX_REQUESTS_PER_SECOND=20

# Scans running at once / waiting in the queue / kept in memory.
MAX_CONCURRENT_SCANS=4
SCAN_QUEUE_SIZE=100
MAX_STORED_SCANS=500

# Timeout for a single outbound request, and for a whole scan.
SCAN_REQUEST_TIMEOUT=10s
SCAN_TIMEOUT=5m

# Passive subdomain discovery through Certificate Transparency (crt.sh and
# Cert Spotter). crt.sh is slow, so it has its own timeout.
SCAN_CT_ENABLED=true
SCAN_CT_TIMEOUT=60s

# Host budgets per scan: how many hosts are resolved, probed over HTTP(S),
# and crawled. Hosts beyond a limit are reported as skipped, not dropped.
SCAN_MAX_RESOLVE_HOSTS=500
SCAN_MAX_PROBE_HOSTS=100
SCAN_MAX_HOSTS=20
# Timeout for resolving one host.
SCAN_DNS_TIMEOUT=5s
# Hosts probed or crawled in parallel.
SCAN_HOST_CONCURRENCY=4

# Per-host crawl budgets: link depth from the host's start page, and the
# maximum number of requests to one host.
SCAN_MAX_DEPTH=2
SCAN_MAX_URLS=100
# Parallel requests to one host.
SCAN_CONCURRENCY=4
# Maximum URLs recorded per host. Pages linking thousands of URLs would
# otherwise make results huge; the rest are counted as omitted.
SCAN_MAX_RECORDED_URLS_PER_HOST=1000
# Per-host request rate limit, shared by all scans.
SCAN_REQUESTS_PER_SECOND=5
# Maximum response body read for HTML/JS/JSON (bytes).
SCAN_MAX_BODY_BYTES=2097152

# Allow requests to loopback/private addresses. Development only: leaving
# this off prevents scans from reaching internal services.
SCAN_ALLOW_PRIVATE_NETWORKS=false
