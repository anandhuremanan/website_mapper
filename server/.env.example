# Web Scanner server configuration. All values are optional; defaults shown.
# The server reads the process environment (it does not load this file itself):
#   set -a; source .env; set +a; go run ./cmd/server
#
# The defaults are development defaults for a small machine, not tuned
# values. Measure on your own hardware before raising them.

SERVER_PORT=8080
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Server-wide limits: shared by every scan
# ---------------------------------------------------------------------------

# Scans running at the same time. Further scans wait in a FIFO queue.
# Raising it lets more users start sooner, but running scans then share the
# global pools below, so each individual scan gets slower. Each running scan
# also uses a few MB for its hosts and its database's page cache.
MAX_CONCURRENT_SCANS=3
# Scans that may wait in the queue; beyond this, new scans get HTTP 503.
SCAN_QUEUE_SIZE=100

# ---------------------------------------------------------------------------
# Result storage: scans and results are kept on disk, one file per scan
# ---------------------------------------------------------------------------

# Directory for the scan databases (created if missing). Relative paths are
# relative to where the server is started.
DATA_DIR=data
# Finished scans are removed, oldest first, when any of these is exceeded.
# Queued and running scans are never removed, and the scan that finished
# last is always kept. Measured at roughly 90 bytes of disk per URL.
MAX_STORED_SCANS=500
STORE_MAX_MB=5120
STORE_MAX_AGE=168h
# New scans are refused (HTTP 503) while the disk has less free space than
# this (checked on Linux; 0 disables the check).
STORE_MIN_FREE_MB=1024

# HTTP requests in flight across ALL scans. This is the main throughput
# control: raising it increases outbound connections, bandwidth and the CPU
# spent parsing HTML. Slots are shared fairly between running scans.
GLOBAL_HTTP_CONCURRENCY=32
# DNS lookups in flight across ALL scans. Lookups are cheap for this server
# but can overload a small local resolver when raised.
GLOBAL_DNS_CONCURRENCY=16
# Download cap for ALL scans together, in KB/s on the wire (compressed
# responses count at their compressed size; 0 = unlimited). A hard ceiling
# on transfer: 1024 KB/s x 30 days = 2.6 TB even if scanning non-stop.
GLOBAL_DOWNLOAD_KBPS=1024

# ---------------------------------------------------------------------------
# Shared discovery cache: reusable lookups shared by all scans
# ---------------------------------------------------------------------------

# Memory budget for the whole cache (70% pages, 10% each for certificate,
# DNS and probe results). 0 disables caching. Entries are charged their
# estimated size; real heap use measured at 0.84-0.97x the estimate.
CACHE_MAX_MB=64
# How long each layer's answers are reused. Certificates change slowly and
# providers are rate-limited; reachability changes quickly.
CACHE_CERT_TTL=6h
CACHE_DNS_TTL=5m
CACHE_PROBE_TTL=2m
CACHE_PAGE_TTL=15m
CACHE_ARCHIVE_TTL=24h

# ---------------------------------------------------------------------------
# Scan modes and route sources
# ---------------------------------------------------------------------------

# Mode used when a request does not choose one: passive (certificate logs,
# web archive, DNS; never contacts the site), light (+ robots.txt and
# sitemaps of live hosts) or full (+ crawling pages).
SCAN_DEFAULT_MODE=light
# Web archive (Wayback Machine) route discovery, and how many archived URLs
# one scan lists. Listings are cached for CACHE_ARCHIVE_TTL.
SCAN_ARCHIVE_ENABLED=true
SCAN_ARCHIVE_MAX_URLS=5000
# Per host: sitemap files read and page URLs taken from them.
SCAN_SITEMAP_MAX_FILES=5
SCAN_SITEMAP_MAX_URLS=2000

# ---------------------------------------------------------------------------
# Per-scan budgets: safety limits for very large domains, not coverage goals.
# A scan that reaches one says so in its status and results.
# ---------------------------------------------------------------------------

# Total duration of one scan. When reached, the scan stops, keeps what it
# found, and reports "scan_timeout". Large domains may need longer.
SCAN_TIMEOUT=30m
# For this many minutes after a scan completes, a request for the same
# target and mode gets that scan back at once instead of a new one (unless
# it asks for a fresh scan). 0 always scans again.
SCAN_REUSE_MINUTES=15
# Outbound HTTP requests one scan may make in total.
SCAN_MAX_REQUESTS=50000
# Bytes one scan may download in total (bodies read plus ~1 KB of headers
# per request). When reached, the scan stops probing and crawling and
# reports download_budget_reached.
SCAN_MAX_DOWNLOAD_MB=500
# Hostnames one scan records. Certificate logs of large domains can list
# tens of thousands of historical names; extra names are counted, not listed.
SCAN_MAX_DISCOVERED_HOSTS=10000
# Hosts resolved, probed over HTTP(S), and crawled per scan. Hosts beyond a
# limit are reported as skipped.
SCAN_MAX_RESOLVE_HOSTS=10000
SCAN_MAX_PROBE_HOSTS=2000
SCAN_MAX_HOSTS=500
# URLs one scan records: a safety ceiling, not a memory limit (URLs are
# written to disk as they are found). Extra URLs are counted as omitted.
# There is no per-host limit. A million URLs is about 90 MB of disk.
SCAN_MAX_RECORDED_URLS=1000000

# Per-host crawl budgets: link depth from the host's start page, and the
# maximum number of requests to one host.
SCAN_MAX_DEPTH=3
SCAN_MAX_URLS=500
# How much of the shared capacity one scan asks for at once: hosts probed or
# crawled in parallel, and parallel requests within one host. The global
# pools above decide how many actually run. Crawls are rate-limited per host,
# so one scan crawls at most SCAN_HOST_CONCURRENCY x SCAN_REQUESTS_PER_SECOND
# requests per second (40/s by default). On real sites that is already about
# what GLOBAL_HTTP_CONCURRENCY=32 sustains, because each request holds a slot
# for its full response time; raise both together if targets respond fast.
SCAN_HOST_CONCURRENCY=8
SCAN_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Requests
# ---------------------------------------------------------------------------

# Timeout for a single outbound request, and for resolving one host.
SCAN_REQUEST_TIMEOUT=10s
SCAN_DNS_TIMEOUT=5s
# Per-host request rate, shared by all scans (politeness towards the site).
# At 5/s a host with SCAN_MAX_URLS=500 takes at least 100 s to crawl.
SCAN_REQUESTS_PER_SECOND=5
# Maximum response body read (bytes). The scanning client reads HTML bodies
# only; certificate-log responses (JSON) use their own larger limit.
SCAN_MAX_BODY_BYTES=2097152
SCAN_USER_AGENT=WebsiteMapper/0.1 (+passive public discovery)

# Passive subdomain discovery through Certificate Transparency (crt.sh and
# Cert Spotter). SCAN_CT_TIMEOUT bounds each provider in total, retries
# included; a provider that fails or times out is recorded as a partial
# error and the other provider's hosts are kept.
SCAN_CT_ENABLED=true
SCAN_CT_TIMEOUT=60s

# Allow requests to loopback/private addresses. Development only: leaving
# this off prevents scans from reaching internal services.
SCAN_ALLOW_PRIVATE_NETWORKS=false
