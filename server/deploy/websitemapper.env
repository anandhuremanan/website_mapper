# Web Scanner: profile for a small shared VPS
# (2 vCPU / 2 GiB RAM / 4 TB monthly transfer, next to other services).
#
# Installed as /etc/websitemapper/websitemapper.env and read by
# websitemapper.service. Every value trades scan size or speed for a smaller
# footprint; see the comments and server/README.md ("Deploying on a small
# shared server") before raising any of them.

SERVER_PORT=9200
LOG_LEVEL=info

# --- Go runtime -------------------------------------------------------------
# Go 1.23 does not read cgroup CPU limits, so set GOMAXPROCS explicitly: the
# scanner uses at most one core, leaving the other to the rest of the server.
GOMAXPROCS=1
# Soft memory limit: the garbage collector works harder as the heap nears
# it, instead of letting the process grow. Keep it below MemoryHigh in the
# systemd unit. Expected live heap with this profile is ~165 MB.
GOMEMLIMIT=300MiB

# --- Scans ------------------------------------------------------------------
# Standard (light) scans list subdomains and routes from archives and
# sitemaps with a few requests per host; users can still choose a full crawl.
SCAN_DEFAULT_MODE=light
SCAN_ARCHIVE_MAX_URLS=5000
MAX_CONCURRENT_SCANS=2
SCAN_QUEUE_SIZE=20
SCAN_TIMEOUT=20m

# --- Memory -----------------------------------------------------------------
# Finished results kept for reloading: ~0.6 KB per URL -> ~60 MB.
MAX_STORED_SCANS=50
MAX_STORED_RESULT_URLS=100000
# Per running scan: ~1 KB per URL -> ~20 MB each.
SCAN_MAX_RECORDED_URLS=20000
SCAN_MAX_RECORDED_URLS_PER_HOST=1000
SCAN_MAX_DISCOVERED_HOSTS=5000
# Shared discovery cache.
CACHE_MAX_MB=32
# In-flight response bodies: at most GLOBAL_HTTP_CONCURRENCY x this (32 MB).
SCAN_MAX_BODY_BYTES=1048576

# --- Network and CPU ----------------------------------------------------------
# Download cap for ALL scans together, in bytes on the wire (compressed
# pages count at their compressed size). A hard ceiling on transfer:
# 512 KB/s x 30 days = 1.3 TB even if scans ran non-stop, leaving most of
# the 4 TB for other services. It also bounds parsing CPU.
GLOBAL_DOWNLOAD_KBPS=512
# One scan may download at most this much, then stops probing and crawling.
SCAN_MAX_DOWNLOAD_MB=200
SCAN_MAX_REQUESTS=20000
# Requests in flight across all scans. Each is held for a full response
# (often 0.5 s+), so this bounds requests per second; it costs little CPU
# or memory, and bandwidth is bounded by the cap above. With 12, python.org
# took 325 s instead of 187 s.
GLOBAL_HTTP_CONCURRENCY=32
GLOBAL_DNS_CONCURRENCY=8
# Hosts one scan crawls at once. Each host is crawled at most
# SCAN_REQUESTS_PER_SECOND, so this sets one scan's crawl speed.
SCAN_HOST_CONCURRENCY=12
SCAN_CONCURRENCY=3
SCAN_REQUESTS_PER_SECOND=5

# --- Scan budgets -------------------------------------------------------------
SCAN_MAX_RESOLVE_HOSTS=5000
SCAN_MAX_PROBE_HOSTS=1000
SCAN_MAX_HOSTS=200
SCAN_MAX_URLS=300
SCAN_MAX_DEPTH=3
