# Where /api/* requests are forwarded (the Go server); see src/proxy.ts.
API_URL=http://localhost:8080
# The secret the Go server expects from this site (its API_PROXY_SECRET).
# Leave empty when the server does not use one.
API_PROXY_SECRET=

# Usage analytics (PostHog); off while the key is empty. The key is a public
# project key (it starts with phc_), not a secret. The host is
# https://us.i.posthog.com or https://eu.i.posthog.com, depending on the
# project's region. See src/lib/analytics.ts for what is and is not sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
